---
import { Badge, ButtonLink, Card, CodeTabs } from "@santi020k/lumen-astro";

import BaseLayout from "../layouts/BaseLayout.astro";
import { multiUserPage, multiUserStructuredData } from "../lib/seo";

const setupExamples = [
  {
    code: `const auth = createMultiUserAuth({
  appName: "Operations workspace",
  authorizeEmail: async (email) => {
    const member = await env.DB.prepare(
      "SELECT active FROM app_members WHERE email = ?",
    )
      .bind(email)
      .first<{ active: number }>();

    return member?.active === 1;
  },
  baseURL: env.AUTH_BASE_URL,
  cookiePrefix: "operations-members",
  database: env.AUTH_DB,
  secret: env.AUTH_SECRET,
  sendVerificationOTP: ({ email, otp }) =>
    sendLoginCode(env, email, otp),
});

app.all("/api/auth/*", (context) =>
  auth.handler(context.req.raw),
);`,
    label: "Dynamic membership",
    language: "typescript",
    value: "dynamic",
  },
  {
    code: `const approvedEmails = new Set([
  "owner@example.com",
  "operator@example.com",
]);

const auth = createMultiUserAuth({
  // authorizeEmail always receives a normalized address.
  authorizeEmail: (email) => approvedEmails.has(email),
  // Supply the remaining application-specific options.
  appName: "Operations workspace",
  baseURL: env.AUTH_BASE_URL,
  cookiePrefix: "operations-members",
  database: env.AUTH_DB,
  secret: env.AUTH_SECRET,
  sendVerificationOTP: ({ email, otp }) =>
    sendLoginCode(env, email, otp),
});`,
    label: "Static allowlist",
    language: "typescript",
    value: "static",
  },
] as const;

const authorizationExample = [
  {
    code: `const identity = await auth.resolveSession(
  context.req.raw.headers,
);

if (!identity) {
  return context.json({ code: "unauthorized" }, 401);
}

const member = await findMemberByUserId(
  env.DB,
  identity.userId,
);

if (member?.role !== "administrator") {
  return context.json({ code: "forbidden" }, 403);
}`,
    label: "Consumer authorization",
    language: "typescript",
    value: "authorization",
  },
] as const;
---

<BaseLayout page={multiUserPage} structuredData={multiUserStructuredData}>
  <section class="docs-hero" aria-labelledby="multi-user-title">
    <div>
      <div class="hero-meta" aria-label="Feature status">
        <Badge variant="success">Multi-user</Badge>
        <span>Planned for v0.3.0</span>
      </div>
      <h1 id="multi-user-title">More accounts, without a shared account system.</h1>
      <p>
        Authenticate every active member approved by the consuming application. The auth package protects the protocol;
        the product remains the source of truth for membership, roles, and permissions.
      </p>
      <div class="hero-actions">
        <ButtonLink href="#configure" showArrow>
          Configure access
        </ButtonLink>
        <ButtonLink href="/#security" variant="secondary" showArrow>
          Review security
        </ButtonLink>
      </div>
    </div>
    <aside>
      <Card class="docs-summary" variant="muted">
        <p class="card-kicker">Boundary at a glance</p>
        <dl class="docs-definition-list">
          <div>
            <dt>Package decides</dt>
            <dd>Whether an email may authenticate now</dd>
          </div>
          <div>
            <dt>Consumer decides</dt>
            <dd>Membership records, roles, invitations, and recovery</dd>
          </div>
          <div>
            <dt>Never shared</dt>
            <dd>Users, sessions, cookies, passkeys, secrets, or databases between products</dd>
          </div>
        </dl>
      </Card>
    </aside>
  </section>

  <div class="docs-layout">
    <nav class="docs-nav" aria-label="On this page">
      <p>On this page</p>
      <a href="#model">Access model</a>
      <a href="#configure">Configuration</a>
      <a href="#authorize">Roles and permissions</a>
      <a href="#revocation">Revocation</a>
      <a href="#migration">Migration checklist</a>
    </nav>

    <div class="docs-content">
      <section id="model" aria-labelledby="model-title">
        <p class="docs-kicker">Access model</p>
        <h2 id="model-title">Authentication is shared code. Membership is application data.</h2>
        <p>
          Use <code>createOwnerAuth</code> when exactly one configured identity may sign in. Use
          <code>createMultiUserAuth</code> when the application has an approved member set. Both modes retain the same
          email-code, passkey, origin, cookie, rate-limit, and D1 isolation controls.
        </p>
        <div class="comparison-table" role="region" aria-label="Authentication mode comparison" tabindex="0">
          <table aria-label="Authentication mode comparison">
            <thead>
              <tr>
                <th scope="col">Concern</th>
                <th scope="col">Single owner</th>
                <th scope="col">Multi-user</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Entry point</th>
                <td>
                  <code>createOwnerAuth</code>
                </td>
                <td>
                  <code>createMultiUserAuth</code>
                </td>
              </tr>
              <tr>
                <th scope="row">Access source</th>
                <td>One configured email</td>
                <td>Consumer callback</td>
              </tr>
              <tr>
                <th scope="row">Roles</th>
                <td>Consumer-owned</td>
                <td>Consumer-owned</td>
              </tr>
              <tr>
                <th scope="row">Identity storage</th>
                <td>Per application</td>
                <td>Per application</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="configure" aria-labelledby="configure-title">
        <p class="docs-kicker">Configuration</p>
        <h2 id="configure-title">Resolve access from the consumer’s source of truth.</h2>
        <p>
          <code>authorizeEmail</code> receives a trimmed, lowercase email address. It can query an app-owned membership
          table or use a small deployment-managed allowlist. Return <code>true</code> only for an identity that is
          currently allowed to authenticate.
        </p>
        <CodeTabs
          ariaLabel="Multi-user access configuration examples"
          items={setupExamples}
          storageKey="auth-multi-user-access-source"
          theme="lumen"
        />
        <Card class="docs-note" variant="muted">
          <h3>Keep discovery private</h3>
          <p>
            Rejected addresses receive the same success-shaped code-request response. No code is delivered or persisted,
            so the endpoint does not reveal whether a person belongs to the application.
          </p>
        </Card>
      </section>

      <section id="authorize" aria-labelledby="authorize-title">
        <p class="docs-kicker">Roles and permissions</p>
        <h2 id="authorize-title">Load permissions after resolving the identity.</h2>
        <p>
          The package returns only a stable user ID and normalized email. Keep administrator, operator, viewer, and
          domain-specific permissions in the consumer, then enforce them at each protected boundary.
        </p>
        <CodeTabs ariaLabel="Consumer authorization example" items={authorizationExample} theme="lumen" />
      </section>

      <section id="revocation" aria-labelledby="revocation-title">
        <p class="docs-kicker">Revocation</p>
        <h2 id="revocation-title">A disabled member stops resolving as authenticated.</h2>
        <p>
          The access callback runs when a code is requested, when identity data is created or updated, before code
          delivery, and whenever the consumer resolves a session. If the callback later returns <code>false</code>,
          <code>resolveSession</code> returns <code>null</code> even if an unexpired session record still exists.
        </p>
        <p>
          The consumer should also provide an administrative sign-out or session-deletion workflow when immediate
          removal of stored sessions is operationally required.
        </p>
      </section>

      <section id="migration" aria-labelledby="migration-title">
        <p class="docs-kicker">Migration checklist</p>
        <h2 id="migration-title">Expand access without weakening isolation.</h2>
        <ol class="checklist">
          <li>Create an additive, application-owned membership table or verified allowlist.</li>
          <li>Keep the existing owner active while the first additional member completes email-code sign-in.</li>
          <li>Verify passkey registration and sign-in for each representative role on the final HTTPS origin.</li>
          <li>Test disabled and removed members against both email-code and existing-session paths.</li>
          <li>Enforce product roles separately and document the application’s recovery process.</li>
        </ol>
      </section>
    </div>
  </div>
</BaseLayout>
