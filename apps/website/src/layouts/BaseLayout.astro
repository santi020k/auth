---
import "@santi020k/lumen-astro/styles.css";
import "../styles/global.css";

import UIPrimitives from "@santi020k/lumen-astro/runtime";
import MetadataHead from "@santi020k/og/astro/head";
import type { PageMetadata } from "@santi020k/og/metadata";
import { type JsonLdDocument, serializeJsonLd } from "@santi020k/og/schema";

import LogoMark from "../assets/logo-mark.svg";
import { authSite } from "../lib/seo";

interface Props {
  page: PageMetadata;
  structuredData?: JsonLdDocument;
}

const { page, structuredData } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <MetadataHead page={page} site={authSite.options} noindexPolicy="minimal" />
    <meta name="application-name" content="santi020k auth" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#173e30" />
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#1d4f3b" />
    <link rel="manifest" href="/site.webmanifest" />
    {structuredData && <script type="application/ld+json" set:html={serializeJsonLd(structuredData)}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <UIPrimitives />
    <header class="site-header">
      <a class="brand" href="/" aria-label="santi020k auth home">
        <LogoMark width="36" height="36" aria-hidden="true" />
        <span>
          <strong>auth</strong>
          <small>by santi020k</small>
        </span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/multi-user">Multi-user</a>
        <a href="/#architecture">Architecture</a>
        <a href="/#security">Security</a>
        <a href="/packages">Packages</a>
        <a href="/#integrate">Integrate</a>
        <a href="/#readiness">Readiness</a>
        <a href="https://github.com/santi020k/auth" target="_blank" rel="noopener noreferrer">
          Source
        </a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Reusable authentication policy. Separate identity state for every application.</p>
      <p>
        Built by{" "}
        <a href="https://santi020k.com" target="_blank" rel="noopener noreferrer">
          Santiago Molina
        </a>
        .
      </p>
    </footer>
  </body>
</html>
