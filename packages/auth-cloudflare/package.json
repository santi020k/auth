{
  "name": "@santi020k/auth-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Owner-only Better Auth policy for Hono applications running on Cloudflare Workers and D1.",
  "license": "MIT",
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:package": "publint . --strict && attw --pack . --profile esm-only",
    "clean": "rm -rf dist dist-test",
    "lint": "eslint src tests --max-warnings=0",
    "test": "tsc -p tsconfig.test.json --outDir dist-test && node --test dist-test/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "hono": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/auth.git",
    "directory": "packages/auth-cloudflare"
  },
  "homepage": "https://auth.santi020k.com",
  "bugs": {
    "url": "https://github.com/santi020k/auth/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
